<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =================================================================== -->
    <!-- Parent -->
    <!-- =================================================================== -->
    <parent>
        <groupId>com.ossantvng.photoapp</groupId>
        <artifactId>api-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- =================================================================== -->
    <!-- Identity -->
    <!-- =================================================================== -->
    <groupId>com.photoapp.feign</groupId>
    <artifactId>photo-app-feign-lib</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>photo-app-feign-lib</name>
    <description>Feign clients for Photo App ecosystem</description>

    <!-- =================================================================== -->
    <!-- Dependencies -->
    <!-- =================================================================== -->
    <dependencies>

        <!-- OpenFeign -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Shared DTOs -->
        <dependency>
            <groupId>com.photoapp.commons</groupId>
            <artifactId>photo-app-commons</artifactId>
        </dependency>

        <!-- Shared Entities -->
        <dependency>
            <groupId>com.photoapp.domain</groupId>
            <artifactId>photo-app-entity-model-lib</artifactId>
        </dependency>

        <!-- Resilience4j -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Shared test fixtures: JWT minting, principals, entity builders,
             and the slice config that loads the REAL security chain. -->
        <dependency>
            <groupId>com.photoapp.test</groupId>
            <artifactId>photo-app-test-support</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The downstream service, for Phase 4. Stubbing at the HTTP boundary is the
             whole point: a mocked Feign interface would prove nothing about the error
             decoder, the fallbacks or the circuit breaker, since all three sit BELOW
             the interface. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Not needed by main: the services get it transitively from
             spring-cloud-starter-netflix-eureka-client. Feign resolves "photo-app-users-service"
             through the load balancer, so without this the test target is an unknown host.
             SimpleDiscoveryClient (spring-cloud-commons, already present) supplies the
             instance list from properties, standing in for Eureka. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @CircuitBreaker and @Retry are Spring AOP annotations, and Resilience4j's aspects
             are @Aspect-annotated. Without aspectjweaver, Spring never registers
             AnnotationAwareAspectJAutoProxyCreator, the aspects are never applied, and every
             resilience assertion here would pass vacuously against a bare Feign call.
             The five services inherit it from spring-boot-starter-data-jpa -> spring-aspects;
             this library has no JPA, so it must ask. Confirmed present in the running
             accounts-service image as aspectjweaver-1.9.25.1.jar. Note there is no
             spring-boot-starter-aop on Boot 4 - the starter was dropped, and the BOM manages
             org.aspectj:aspectjweaver directly. -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Supplies DataWebProperties, which FeignClientsConfiguration$SpringDataConfiguration
             needs. That nested config is what contributes the Encoder once Spring Data is on the
             classpath: the plain feignEncoder bean is @ConditionalOnMissingClass(Pageable) and
             spring-data-commons arrives transitively through photo-app-commons, so it is always
             skipped here. Without this artifact the config does not match, no Encoder is
             registered at all, and every client fails to build with
             "No bean found of type interface feign.codec.Encoder". The services get it from
             spring-boot-starter-data-jpa (spring-boot-data-commons-4.0.6.jar, confirmed in the
             running accounts-service image); this library has no JPA, so it must ask. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-commons</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The transport production runs on, and the reason it is OPTIONAL here.

             The five business services declare feign-hc5 themselves (added 2026-08-07 to fix the
             PATCH defect Phase 4 found). Optional means this library can COMPILE against it -
             FeignTransportAutoConfiguration needs HttpClientBuilder to turn off HttpClient 5's
             own retry strategy - without forcing the transport on anything that consumes the
             library. The auto-configuration is @ConditionalOnClass, so it is simply inert if a
             consumer has not asked for hc5.

             Optional still puts it on THIS module's own test classpath, which is required: the
             suite must run the same transport production does, or PatchVerbTest and
             RetryBehaviourTest would be asserting the behaviour of a client nothing ships. -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-hc5</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =================================================================== -->
    <!-- Build -->
    <!-- =================================================================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>