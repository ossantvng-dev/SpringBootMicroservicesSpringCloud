<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =================================================================== -->
    <!-- Parent -->
    <!-- =================================================================== -->
    <parent>
        <groupId>com.ossantvng.photoapp</groupId>
        <artifactId>api-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- =================================================================== -->
    <!-- Identity -->
    <!-- =================================================================== -->
    <groupId>com.photoapp.commons</groupId>
    <artifactId>photo-app-commons</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>photo-app-commons</name>
    <description>Common utilities for Photo App ecosystem</description>

    <!-- =================================================================== -->
    <!-- Dependencies -->
    <!-- =================================================================== -->
    <dependencies>

        <!-- Persistence-adjacent types only. This library has no entities, no
             repositories and no Hibernate usage, so it deliberately does NOT depend on
             spring-boot-starter-data-jpa. Each artifact below backs one specific need:
               jakarta.persistence-api  -> OptimisticLockException  (GlobalExceptionHandler)
               spring-tx                -> DataAccessException      (GlobalExceptionHandler)
               spring-data-commons      -> Pageable/PageRequest/Sort (pagination DTOs+util)
             Versions come from spring-boot-starter-parent. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- AccessDeniedException only, so GlobalExceptionHandler can turn an
             insufficient-role denial into 403 instead of letting the catch-all
             report it as 500. Deliberately spring-security-core, not the starter. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MapStruct: compile-time mapping, processor wired in the parent pom -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- Entities: required by the mappers, which need both sides of every pair.
             entity-model-lib has no internal dependencies, so this cannot cycle. -->
        <dependency>
            <groupId>com.photoapp.domain</groupId>
            <artifactId>photo-app-entity-model-lib</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Tests.
             Deliberately NOT photo-app-test-support: that module depends on this one, and
             Maven rejects module cycles regardless of scope. This library's suite therefore
             builds what it needs locally from the plain starter - JUnit 5, AssertJ, Mockito
             and spring-test's standalone MockMvc. See docs/TESTING.md §1. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =================================================================== -->
    <!-- Build -->
    <!-- =================================================================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>