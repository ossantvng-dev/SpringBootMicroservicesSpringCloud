<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- ====================================================== -->
	<!-- Parent -->
	<!-- ====================================================== -->
	<parent>
		<groupId>com.ossantvng.photoapp</groupId>
		<artifactId>api-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<!-- ====================================================== -->
	<!-- Identity -->
	<!-- ====================================================== -->
	<groupId>com.photoapp.accounts</groupId>
	<artifactId>photo-app-accounts-service</artifactId>
	<name>photo-app-accounts-service</name>
	<description>Accounts microservice for Photo App</description>

	<!-- ====================================================== -->
	<!-- Dependencies -->
	<!-- ====================================================== -->
	<dependencies>

		<!-- Core Spring -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Cloud -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-bus-amqp</artifactId>
		</dependency>

		<!-- DB -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Span transport: replaces Boot's JDK-HttpClient sender -->
		<dependency>
			<groupId>com.photoapp.tracing</groupId>
			<artifactId>photo-app-tracing-lib</artifactId>
		</dependency>

		<!-- Zipkin y Micrometer -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-brave</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-zipkin</artifactId>
		</dependency>
		<dependency>
			<groupId>net.ttddyy.observation</groupId>
			<artifactId>datasource-micrometer-spring-boot</artifactId>
		</dependency>

		<!-- OpenAPI / Swagger UI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<!-- Logstash Logback Encoder -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
		</dependency>

		<!-- Internal libs -->
		<dependency>
			<groupId>com.photoapp.domain</groupId>
			<artifactId>photo-app-entity-model-lib</artifactId>
		</dependency>

		<dependency>
			<groupId>com.photoapp.commons</groupId>
			<artifactId>photo-app-commons</artifactId>
		</dependency>

		<dependency>
			<groupId>com.photoapp.feign</groupId>
			<artifactId>photo-app-feign-lib</artifactId>
		</dependency>

		<dependency>
			<groupId>com.photoapp.security</groupId>
			<artifactId>photo-app-security-lib</artifactId>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Tests -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Shared test fixtures: JWT minting, principals, entity builders,
		     and the slice config that loads the REAL security chain. -->
		<dependency>
			<groupId>com.photoapp.test</groupId>
			<artifactId>photo-app-test-support</artifactId>
			<scope>test</scope>
		</dependency>


	</dependencies>

	<!-- =================================================================== -->
	<!-- Build -->
	<!-- =================================================================== -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	
</project>