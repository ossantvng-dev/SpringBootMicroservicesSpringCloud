<configuration>

    <springProperty name="env" source="spring.profiles.active"/>
    <springProperty name="serviceName" source="spring.application.name"/>

    <property name="LOG_BASE" value="${LOG_BASE:-api-parent/infrastructure}"/>
    <property name="LOG_PATH" value="${LOG_BASE}/${serviceName}/logs"/>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/${serviceName}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${serviceName}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory>
        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>
                {
                "service":"${serviceName}",
                "environment":"${env}"
                }
            </customFields>
        </encoder>

    </appender>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>
                {
                "service":"${serviceName}",
                "environment":"${env}"
                }
            </customFields>
        </encoder>

    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>

</configuration>