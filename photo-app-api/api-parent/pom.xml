<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- =================================================================== -->
	<!-- Parent Spring Boot -->
	<!-- =================================================================== -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>
	<groupId>com.ossantvng.photoapp</groupId>
	<artifactId>api-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>api-parent</name>
	<description>API Parent for Photo App ecosystem</description>
	<!-- =================================================================== -->
	<!-- Properties -->
	<!-- =================================================================== -->
	<properties>
		<java.version>25</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>${java.version}</maven.compiler.release>
		<spring-cloud.version>2025.1.1</spring-cloud.version>
		<hibernate.version>7.2.7.Final</hibernate.version>
		<lombok.version>1.18.44</lombok.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
		<datasource-micrometer.version>2.2.1</datasource-micrometer.version>
		<logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
		<!-- 3.0.x is the Boot 4 line; 3.1.0 targets Boot 4.1 and is ahead of this reactor -->
		<springdoc.version>3.0.3</springdoc.version>
		<!-- Test tooling -->
		<testcontainers.version>1.20.4</testcontainers.version>
		<wiremock.version>3.10.0</wiremock.version>
		<awaitility.version>4.2.2</awaitility.version>
		<json-unit.version>4.1.0</json-unit.version>
		<jacoco.version>0.8.15</jacoco.version>
		<maven-failsafe.version>3.5.2</maven-failsafe.version>
	</properties>
	<!-- =================================================================== -->
	<!-- Modules -->
	<!-- =================================================================== -->
	<modules>
		<!-- Libraries -->
		<module>libraries/photo-app-commons</module>
		<module>libraries/photo-app-entity-model-lib</module>
		<module>libraries/photo-app-feign-lib</module>
		<module>libraries/photo-app-security-lib</module>
		<module>libraries/photo-app-tracing-lib</module>
		<!-- Consumed at test scope only; never reaches a production image -->
		<module>libraries/photo-app-test-support</module>

		<!-- Services -->
		<module>services/photo-app-authorization-service</module>
		<module>services/photo-app-users-service</module>
		<module>services/photo-app-accounts-service</module>
		<module>services/photo-app-albums-service</module>
		<module>services/photo-app-photos-service</module>

		<!-- Infrastructure -->
		<module>infrastructure/photo-app-api-gateway</module>
		<module>infrastructure/photo-app-configuration-server</module>
		<module>infrastructure/photo-app-discovery-service</module>
		<module>infrastructure/photo-app-discovery-service-cluster</module>
	</modules>
	<!-- =================================================================== -->
	<!-- Dependency Management -->
	<!-- =================================================================== -->
	<dependencyManagement>
		<dependencies>
			<!-- Spring Cloud BOM -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Datasource micrometer version -->
			<dependency>
				<groupId>net.ttddyy.observation</groupId>
				<artifactId>datasource-micrometer-bom</artifactId>
				<version>${datasource-micrometer.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Shared Versions -->
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
			</dependency>
			<dependency>
				<groupId>org.hibernate.orm</groupId>
				<artifactId>hibernate-processor</artifactId>
				<version>${hibernate.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>net.logstash.logback</groupId>
				<artifactId>logstash-logback-encoder</artifactId>
				<version>${logstash-logback-encoder.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
			<!-- Test tooling. The Testcontainers BOM keeps its modules aligned. -->
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.wiremock</groupId>
				<artifactId>wiremock-standalone</artifactId>
				<version>${wiremock.version}</version>
			</dependency>
			<dependency>
				<groupId>org.awaitility</groupId>
				<artifactId>awaitility</artifactId>
				<version>${awaitility.version}</version>
			</dependency>
			<dependency>
				<groupId>net.javacrumbs.json-unit</groupId>
				<artifactId>json-unit-assertj</artifactId>
				<version>${json-unit.version}</version>
			</dependency>
			<dependency>
				<groupId>com.photoapp.test</groupId>
				<artifactId>photo-app-test-support</artifactId>
				<version>1.0-SNAPSHOT</version>
			</dependency>
			<!-- Internal Libraries -->
			<dependency>
				<groupId>com.photoapp.commons</groupId>
				<artifactId>photo-app-commons</artifactId>
				<version>1.0-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.photoapp.domain</groupId>
				<artifactId>photo-app-entity-model-lib</artifactId>
				<version>1.0-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.photoapp.tracing</groupId>
				<artifactId>photo-app-tracing-lib</artifactId>
				<version>1.0-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.photoapp.feign</groupId>
				<artifactId>photo-app-feign-lib</artifactId>
				<version>1.0-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>com.photoapp.security</groupId>
				<artifactId>photo-app-security-lib</artifactId>
				<version>1.0-SNAPSHOT</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<!-- =================================================================== -->
	<!-- Build -->
	<!-- =================================================================== -->
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
				<!--
					Two tiers, split on the class-name suffix:
					  *Test - fast, no Docker, run by surefire in the `test` phase
					  *IT   - Testcontainers or full context, run by failsafe in `verify`
					`mvn test` therefore stays fast and Docker-free, while `mvn verify` runs
					everything. When CI arrives the two can be scheduled differently without
					restructuring anything.
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>${maven-failsafe.version}</version>
					<configuration>
						<includes>
							<include>**/*IT.java</include>
						</includes>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>integration-test</goal>
								<goal>verify</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<!-- Coverage for VISIBILITY only - deliberately no build-failing threshold.
				     A global percentage rewards testing getters; the real targets are named
				     in testing-plan.md Part 4 decision 6. -->
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
					<executions>
						<execution>
							<id>prepare-agent</id>
							<goals><goal>prepare-agent</goal></goals>
						</execution>
						<execution>
							<id>report</id>
							<phase>verify</phase>
							<goals><goal>report</goal></goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.14.1</version>
					<configuration>
						<release>${java.version}</release>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
							<!-- Must sit between lombok and mapstruct-processor so the
							     accessors Lombok generates are visible to MapStruct -->
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok-mapstruct-binding</artifactId>
								<version>${lombok-mapstruct-binding.version}</version>
							</path>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
							<path>
								<groupId>org.hibernate.orm</groupId>
								<artifactId>hibernate-processor</artifactId>
								<version>${hibernate.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<!--
			Actually BOUND in every module. pluginManagement above only pins versions and
			configuration; a plugin declared there and nowhere else never executes. Without
			this section `mvn verify` would run zero *IT tests and JaCoCo would emit no
			report, both silently - the failure mode being that the command appears to work.
		-->
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>