# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# ---------------------------------------------------------------- MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=photo_app
MYSQL_USER=photo_app_user
MYSQL_PASSWORD=password

# ---------------------------------------------------------------- RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---------------------------------------------------------------- Config Server
# Used by the Config Server itself and by every client that reads from it.
CONFIG_SERVER_ADMIN_USER=config_admin
CONFIG_SERVER_ADMIN_PASSWORD=change-me

# Password of the encryption keystore. The keystore file itself is bind-mounted
# at runtime and never baked into an image.
KEYSTORE_PASSWORD=change-me

# Fine-grained, read-only, Contents:Read PAT scoped ONLY to
# photo-app-configuration-repo. Separate from any broader token.
GIT_USERNAME=your-github-username
GIT_TOKEN=github_pat_...

# ---------------------------------------------------------------- ELK
# xpack.security is enabled, so these are required.
ELASTIC_PASSWORD=change-me-elastic
KIBANA_SYSTEM_PASSWORD=change-me-kibana
ELK_VERSION=8.13.0
